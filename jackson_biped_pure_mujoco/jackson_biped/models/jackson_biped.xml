<mujoco model="jackson_biped">
  <compiler angle="radian" coordinate="local" inertiafromgeom="true"/>
  <option integrator="Euler" timestep="0.002" gravity="0 0 -9.81"/>

  <default>
    <joint armature="0.01" damping="0.5" frictionloss="0.1"/>
    <geom contype="1" conaffinity="1" friction="0.8 0.1 0.1" density="1000"/>
    <motor gear="1"/>
  </default>

  <worldbody>
    <light directional="true" diffuse=".8 .8 .8" specular=".2 .2 .2" pos="0 0 5" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="0 0 1" pos="0 0 0" contype="1" conaffinity="1" friction="1.0 0.1 0.1"/>

    <!-- Torso / Base Link -->
    <body name="torso" pos="0 0 0.85">
      <freejoint name="root_joint"/>
      <geom name="torso_geom" type="box" size="0.12 0.10 0.22" mass="12.0" pos="0 0 0"/>
      <site name="imu_site" pos="0 0 0"/>

      <!-- LEFT LEG -->
      <body name="left_hip_yaw_link" pos="0 0.09 -0.18">
        <joint name="left_HAA" axis="0 0 1" range="-0.52 0.52" damping="1.0"/>
        <geom type="cylinder" size="0.04 0.05" mass="1.2" pos="0 0 0"/>

        <body name="left_hip_roll_link" pos="0 0.02 -0.05">
          <joint name="left_HR" axis="1 0 0" range="-0.35 0.35" damping="1.0"/>
          <geom type="cylinder" size="0.04 0.05" mass="1.2" pos="0 0 0"/>

          <body name="left_thigh_link" pos="0 0 -0.05">
            <joint name="left_HFE" axis="0 1 0" range="-1.57 1.05" damping="1.5"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.32" size="0.045" mass="2.5"/>

            <body name="left_shin_link" pos="0 0 -0.32">
              <joint name="left_KFE" axis="0 1 0" range="0.0 2.09" damping="1.5"/>
              <geom type="capsule" fromto="0 0 0 0 0 -0.32" size="0.038" mass="1.8"/>

              <body name="left_ankle_pitch_link" pos="0 0 -0.32">
                <joint name="left_FFE" axis="0 1 0" range="-0.87 0.52" damping="0.8"/>
                <geom type="sphere" size="0.03" mass="0.4"/>

                <body name="left_faa" pos="0 0 -0.03">
                  <joint name="left_FAA" axis="1 0 0" range="-0.35 0.35" damping="0.8"/>
                  <geom name="left_foot_geom" type="box" size="0.10 0.05 0.015" pos="0.02 0 -0.015" mass="0.6"/>
                  <site name="left_foot_contact_site" pos="0 0 -0.02"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- RIGHT LEG -->
      <body name="right_hip_yaw_link" pos="0 -0.09 -0.18">
        <joint name="right_HAA" axis="0 0 1" range="-0.52 0.52" damping="1.0"/>
        <geom type="cylinder" size="0.04 0.05" mass="1.2" pos="0 0 0"/>

        <body name="right_hip_roll_link" pos="0 -0.02 -0.05">
          <joint name="right_HR" axis="1 0 0" range="-0.35 0.35" damping="1.0"/>
          <geom type="cylinder" size="0.04 0.05" mass="1.2" pos="0 0 0"/>

          <body name="right_thigh_link" pos="0 0 -0.05">
            <joint name="right_HFE" axis="0 1 0" range="-1.57 1.05" damping="1.5"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.32" size="0.045" mass="2.5"/>

            <body name="right_shin_link" pos="0 0 -0.32">
              <joint name="right_KFE" axis="0 1 0" range="0.0 2.09" damping="1.5"/>
              <geom type="capsule" fromto="0 0 0 0 0 -0.32" size="0.038" mass="1.8"/>

              <body name="right_ankle_pitch_link" pos="0 0 -0.32">
                <joint name="right_FFE" axis="0 1 0" range="-0.87 0.52" damping="0.8"/>
                <geom type="sphere" size="0.03" mass="0.4"/>

                <body name="right_faa" pos="0 0 -0.03">
                  <joint name="right_FAA" axis="1 0 0" range="-0.35 0.35" damping="0.8"/>
                  <geom name="right_foot_geom" type="box" size="0.10 0.05 0.015" pos="0.02 0 -0.015" mass="0.6"/>
                  <site name="right_foot_contact_site" pos="0 0 -0.02"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>

    </body>
  </worldbody>

  <actuator>
    <motor name="left_HAA_motor" joint="left_HAA" gear="40"/>
    <motor name="left_HR_motor" joint="left_HR" gear="40"/>
    <motor name="left_HFE_motor" joint="left_HFE" gear="60"/>
    <motor name="left_KFE_motor" joint="left_KFE" gear="80"/>
    <motor name="left_FFE_motor" joint="left_FFE" gear="30"/>
    <motor name="left_FAA_motor" joint="left_FAA" gear="30"/>

    <motor name="right_HAA_motor" joint="right_HAA" gear="40"/>
    <motor name="right_HR_motor" joint="right_HR" gear="40"/>
    <motor name="right_HFE_motor" joint="right_HFE" gear="60"/>
    <motor name="right_KFE_motor" joint="right_KFE" gear="80"/>
    <motor name="right_FFE_motor" joint="right_FFE" gear="30"/>
    <motor name="right_FAA_motor" joint="right_FAA" gear="30"/>
  </actuator>

  <sensor>
    <touch name="left_foot_touch" site="left_foot_contact_site"/>
    <touch name="right_foot_touch" site="right_foot_contact_site"/>
    <gyro name="torso_gyro" site="imu_site"/>
    <accelerometer name="torso_accel" site="imu_site"/>
  </sensor>
</mujoco>
